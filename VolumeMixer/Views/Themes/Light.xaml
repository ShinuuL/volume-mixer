<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme colors -->
    <SolidColorBrush x:Key="PanelBrush" Color="#F7F7F7" />
    <SolidColorBrush x:Key="RowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#EAEAEA" />
    <SolidColorBrush x:Key="SubtextBrush" Color="#666666" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#FFF0E0" />
    <SolidColorBrush x:Key="ErrorFgBrush" Color="#B85C00" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="TextBoxBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextBoxFgBrush" Color="#1B1B1B" />
    <SolidColorBrush x:Key="MuteActiveBrush" Color="#D13438" />
</ResourceDictionary>
