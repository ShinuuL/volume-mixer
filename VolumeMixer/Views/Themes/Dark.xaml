<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark theme colors -->
    <SolidColorBrush x:Key="PanelBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="RowBrush" Color="#2D2D2D" />
    <SolidColorBrush x:Key="ForegroundBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="HoverBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SubtextBrush" Color="#999999" />
    <SolidColorBrush x:Key="ErrorBgBrush" Color="#3D2200" />
    <SolidColorBrush x:Key="ErrorFgBrush" Color="#FFB366" />
    <SolidColorBrush x:Key="BorderBrush" Color="#444444" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#444444" />
    <SolidColorBrush x:Key="TextBoxBgBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextBoxFgBrush" Color="#E0E0E0" />
    <SolidColorBrush x:Key="MuteActiveBrush" Color="#FF6B6B" />
</ResourceDictionary>
